direction: down

goal: "GARANTIZAR BIENESTAR SOCIAL\nY SOBERANÍA ENERGÉTICA" {
  shape: oval
  style.fill: "#d4edda"
}

req_a: "Mantener la cadena integrada\npara amortiguar precios y shocks" {
  shape: rectangle
}

req_b: "Eliminar el drenaje de caja\ny recortar activos deficitarios" {
  shape: rectangle
}

conflict: "EL CONFLICTO:\n¿ESCINDIR O RECURSAR PEMEX?" {
  shape: diamond
  style.fill: "#f8d7da"
}

prereq_a: "Absorber pérdidas con deuda\no subsidios fiscales estatales" {
  shape: rectangle
}

prereq_b: "Vender o segregar unidades\ncon márgenes contables negativos" {
  shape: rectangle
}

goal -> req_a
goal -> req_b
req_a -> conflict
req_b -> conflict
conflict -> prereq_a
conflict -> prereq_b

